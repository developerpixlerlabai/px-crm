# ─────────────────────────────────────────────────────────────────────────────
# px-crm environment
#
#   cp .env.example .env.local     then fill in the values below
#
# .env.local is gitignored. Never commit real values into THIS file.
# Restart `npm run dev` after editing (Next reloads env, but a stale process
# keeps the old values for anything already imported).
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
# 1. LEADS SHEET  —  required, the app shows a setup screen without it
# ═════════════════════════════════════════════════════════════════════════════
# From AS/Api.gs in the Apps Script project attached to the leads spreadsheet.
# Setup steps are in README.md.

# Apps Script → Deploy → New deployment → type "Web app"
#   Execute as: Me   ·   Who has access: Anyone
# Copy the /exec URL. "Anyone" is safe because every request must carry the
# token below; without it the API returns 401.
SHEETS_API_URL=https://script.google.com/macros/s/AKfy.../exec

# Run setupApi() in the Apps Script editor, then View → Logs and copy the token.
SHEETS_API_TOKEN=

# Link to the spreadsheet itself, shown as the "Open sheet" button in the header.
# NEXT_PUBLIC_ means this one IS exposed to the browser — a sheet URL is
# harmless. The token above must never get that prefix.
NEXT_PUBLIC_SHEET_URL=https://docs.google.com/spreadsheets/d/.../edit

# Optional. Point the dashboard at a copy of the Leads tab to develop against
# throwaway data while the scraper keeps filling the real one. Unset = live
# "Leads" tab. Requires `tab` support in Api.gs, redeployed as a NEW version.
# SHEETS_TAB="Copy of Leads"


# ═════════════════════════════════════════════════════════════════════════════
# 2. GMAIL SYNC  —  optional; the Mailboxes button explains itself when unset
# ═════════════════════════════════════════════════════════════════════════════
# Full walkthrough: docs/GMAIL-SYNC.md

# ── Supabase (mailbox registry + encrypted refresh tokens) ───────────────────
# Supabase Dashboard → Project Settings → API
#
# ALSO REQUIRED, and not an env var: add `private` to "Exposed schemas" on that
# same settings page, or the Vault RPCs are unreachable and every connect ends
# with "the token could not be stored".
# And apply supabase/migrations/0001_mailboxes.sql before connecting anything.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# The SECRET key (sb_secret_...), NOT the publishable/anon one.
#
# Why it has to be the secret key: connected_mailboxes runs RLS with zero
# policies and the Vault RPCs are revoked from `anon`, so a publishable key reads
# nothing and stores nothing. Older projects call this service_role —
# SUPABASE_SERVICE_ROLE_KEY is accepted as a fallback name.
#
# Server-only: it bypasses RLS, so it must never gain a NEXT_PUBLIC_ prefix or
# reach a client bundle.
SUPABASE_SECRET_KEY=

# ── Google OAuth (per-mailbox Gmail grant) ──────────────────────────────────
# Google Cloud Console → APIs & Services
#   1. Enable the Gmail API
#   2. OAuth consent screen → External → add every teammate who will connect a
#      mailbox as a TEST USER (an unlisted account cannot grant an unverified
#      app, and gmail.readonly is a sensitive scope)
#   3. Credentials → Create OAuth client ID → Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match an "Authorised redirect URI" on that OAuth client BYTE FOR BYTE.
# Google allows no query parameters and no trailing-slash mismatch. Register the
# localhost one for development and your deployed origin for production.
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3000/api/mailboxes/google/callback


# ═════════════════════════════════════════════════════════════════════════════
# 3. NOT YET USED  —  later phases of docs/GMAIL-SYNC.md
# ═════════════════════════════════════════════════════════════════════════════
# Leave these out until the phase that needs them.

# Phase 0 (login gate). Browser-side Supabase key — publishable by design, so it
# is safe in a client bundle. Older projects call this the anon key.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Phase 1F (reply → status cron). Public https origin, and the cron bearer.
# An unset CRON_SECRET makes the cron route 401 everything — it fails closed.
# APP_URL=http://localhost:3000
# CRON_SECRET=

# Phase 2 (push sync). Topic must be the FULL resource name.
# GMAIL_PUBSUB_TOPIC=projects/<project>/topics/<topic>
# GMAIL_PUBSUB_AUDIENCE=

# ---------------------------------------------------------------------------
# Dashboard login (shared password wall)
# ---------------------------------------------------------------------------
# Optional. Without these the defaults are admin / pixlerlab, which is fine for
# local work but should be changed before the app is reachable from the web.
CRM_USERNAME=admin
CRM_PASSWORD=admin12!@
# Optional. Signs the session cookie; when unset it is derived from the
# credentials above. Set it to any long random string to rotate every session
# without changing the password.
CRM_AUTH_SECRET=
